# این مقادیر را در فایل .env.local ریشه پروژه قرار دهید.
DB_SERVER=localhost
DB_PORT=1433
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=DBEntekhabat

# حداقل 32 کاراکتر تصادفی؛ این مقدار فقط برای امضای JWT است.
JWT_SECRET=replace_with_a_long_random_jwt_secret

# همین مقدار باید یک‌بار در Security.AuthConfig نیز ثبت شود.
HASH_SECRET=replace_with_a_long_random_hash_secret
